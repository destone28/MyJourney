# Django Configuration
# Copy this file to .env and update with your actual values
# DO NOT commit .env to version control

# Django Secret Key (REQUIRED in production)
# Generate a new one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
DJANGO_SECRET_KEY=your-secret-key-here

# Debug mode (set to False in production)
DJANGO_DEBUG=False

# Allowed hosts (comma-separated, no spaces)
# Example: example.com,www.example.com,localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DJANGO_LOG_LEVEL=INFO

# Database Configuration (if using PostgreSQL in production)
# DATABASE_URL=postgres://user:password@localhost:5432/dbname
